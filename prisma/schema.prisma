// Litara — Prisma schema (PostgreSQL)
// Set DATABASE_URL in .env.local / Vercel env vars.
// Local dev without a Postgres server: create a free hosted Postgres
// at Neon (neon.tech) or Supabase and paste its connection string.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  sessions     Session[]
  projects     Project[]
  memberships  ProjectMember[]
  decisions    Decision[]
  subscription Subscription?
  payments     Payment[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Project {
  id             String    @id @default(cuid())
  title          String
  researchQuestion String  @db.Text
  inclusion      String    @default("") @db.Text
  exclusion      String    @default("") @db.Text
  blindMode      Boolean   @default(true) // Blind Mode aktif default (ala Rayyan)
  ownerId        String
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  articles       Article[]
  reviewers      Reviewer[]
  members        ProjectMember[]
  relevanceModel RelevanceModel?
}

model Reviewer {
  id        String  @id @default(cuid())
  name      String
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, name])
}

// Kolaborator dengan akun Litara (diundang pemilik via email).
// Peran: editor (screening + ubah) | reviewer (screening) | viewer (lihat saja).
model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String  @default("reviewer")
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

// Model Peringkat Relevansi (Naive Bayes) yang dilatih dari keputusan tim.
// wordStats: { kata: [jumlahDiInclude, jumlahDiExclude] }
model RelevanceModel {
  id           String   @id @default(cuid())
  projectId    String   @unique
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trainedAt    DateTime @default(now())
  includeCount Int      @default(0)
  excludeCount Int      @default(0)
  wordStats    Json     @default("{}")
  totalVocab   Int      @default(0)
}

model Article {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  authors   String   @default("")
  year      Int?
  journal   String   @default("")
  source    String   @default("Manual") // Scopus, SINTA, Garuda, WoS, DOAJ, Manual
  doi       String   @default("")
  abstract  String   @default("") @db.Text
  keywords  String   @default("")
  relevance Int      @default(0) // 0-100, from research-question keywords
  learned   Int?     // 0-100, Naive Bayes dari keputusan tim (null = belum dihitung)
  consensus String   @default("") // keputusan konsensus tim: include | exclude | ""
  duplicateOfId String?
  labels    String   @default("") // comma-separated
  createdAt DateTime @default(now())
  decisions Decision[]
  extractions Extraction[]
  riskAssessments RiskAssessment[]
}

model Decision {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reviewer  String // reviewer name (or user name)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  value     String // include | exclude | maybe
  reason    String   @default("")
  stage     String   @default("title_abstract") // title_abstract | fulltext
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([articleId, reviewer, stage])
}

// Ekstraksi data terstruktur per studi (tahap Extraction), per reviewer.
model Extraction {
  id           String   @id @default(cuid())
  articleId    String
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reviewer     String
  design       String   @default("")
  population   String   @default("") @db.Text
  intervention String   @default("") @db.Text
  outcomes     String   @default("") @db.Text
  sampleSize   String   @default("")
  notes        String   @default("") @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([articleId, reviewer])
}

// Penilaian Risk of Bias per studi (tahap RoB), per reviewer.
// Domain 0-3: 0 belum dinilai, 1 rendah, 2 sedang, 3 tinggi.
model RiskAssessment {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reviewer    String
  selection   Int      @default(0)
  performance Int      @default(0)
  detection   Int      @default(0)
  attrition   Int      @default(0)
  reporting   Int      @default(0)
  overall     String   @default("")
  notes       String   @default("") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([articleId, reviewer])
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String   @default("free") // free | pro | institusi
  status    String   @default("active")
  trialEndsAt DateTime?
  renewsAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String   @unique // LITARA-xxxx
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        String
  amount      Int // in IDR
  method      String   @default("qris") // qris | ewallet | transfer | invoice | card
  status      String   @default("pending") // pending | paid | failed
  mode        String   @default("simulasi") // simulasi | midtrans
  redirectUrl String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
